{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/tests/**/*",
            "!{projectRoot}/**/*.spec.*",
            "!{projectRoot}/**/*.test.*"
        ],
        "sharedGlobals": ["{workspaceRoot}/package-lock.json"]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"],
            "cache": true
        },
        "types:check": {
            "dependsOn": ["^types:check"],
            "inputs": ["default", "^default"],
            "cache": true
        },
        "lint": {
            "inputs": ["default"],
            "cache": true
        },
        "lint:check": {
            "inputs": ["default"],
            "cache": true
        },
        "check": {
            "inputs": ["default"],
            "cache": true
        }
    }
}
