# =============================================================================
# Production environment. Copy to .env.prod, fill in every CHANGE_ME, then
# `chmod 600 .env.prod`. This file is consumed twice:
#   - bind-mounted into the app container as /var/www/html/.env
#   - passed to compose via --env-file for ${...} substitution
# Both readers must agree, which is why the DB credentials live here only.
# =============================================================================

APP_NAME=HRIS
APP_ENV=production
APP_KEY=base64:CHANGE_ME_run_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=https://hris.example.com

# Attendance late/grace calculations are timezone-sensitive and the server
# clock is UTC. config/app.php falls back to Asia/Makassar (WITA); set this
# explicitly to the office timezone or every late check is off by an hour.
APP_TIMEZONE=Asia/Jakarta

# -----------------------------------------------------------------------------
# Public hostnames. Rendered into the nginx container's server_name at start,
# so they are deployment configuration and never baked into an image. Both
# must have an A record pointing at this server before Caddy can issue
# certificates.
# -----------------------------------------------------------------------------
HRIS_DASHBOARD_HOST=hris.example.com
HRIS_PORTAL_HOST=portal.example.com
# Optional: the attendance kiosk terminal. Leave unset if there is no terminal.
# HRIS_KIOSK_HOST=absen.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Served over TLS by Caddy, so the session cookie must never travel in clear.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log discards mail, which means password resets never arrive.
# Point this at a real transport before letting users self-serve resets.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Bootstrap administrator — consumed once by ProductionSeeder.
# Both are mandatory in production; the seeder aborts rather than fall back to
# a default credential. Change the password after the first login.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# GPS anti-spoofing thresholds.
#
# The office geofence itself is NOT configured here. An admin sets it under
# Attendance Settings and it is stored in the database. Until that is done the
# geofence is inactive and employees can clock in from anywhere, so make it a
# go-live step.
# -----------------------------------------------------------------------------
GPS_MAX_ACCURACY_METERS=150
GPS_MAX_AGE_SECONDS=60

# Days of api_logs kept. Every /api request writes a row, pruned nightly by
# the scheduler. Raising this on a small disk is how the disk fills up.
API_LOG_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Face recognition microservice.
# -----------------------------------------------------------------------------
FACE_RECOGNITION_ENABLED=true
FACE_SERVICE_URL=http://face-recognition:5000
FACE_DISTANCE_THRESHOLD=0.5
FACE_REQUIRE_ENROLLMENT=true

# -----------------------------------------------------------------------------
# Attendance kiosk terminal.
#
# The terminal identifies a face against the whole roster (1:N) instead of
# confirming an already-authenticated one, so the bar is deliberately higher
# than FACE_DISTANCE_THRESHOLD above: a 1:N search gets one chance to be wrong
# per enrolled employee. MARGIN is how much closer the winner must be than the
# runner-up before the terminal will commit to a name.
#
# The feature itself is switched on per installation from the admin settings,
# and each terminal needs a token from `php artisan kiosk:register`.
# -----------------------------------------------------------------------------
KIOSK_IDENTIFY_THRESHOLD=0.38
KIOSK_IDENTIFY_MARGIN=0.06
KIOSK_SCAN_TTL_SECONDS=90

VITE_APP_NAME=HRIS
