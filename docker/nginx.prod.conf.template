# =============================================================================
# Client IP resolution
#
# nginx's peer here is Caddy on the host, so $remote_addr would otherwise be
# the Docker gateway for EVERY request — putting all traffic in one rate-limit
# bucket and making limit_req useless. The realip module rewrites it from
# X-Forwarded-For instead.
#
# real_ip_recursive is off deliberately. With it off nginx takes the LAST
# address in the header, which is the one Caddy appended — so a client sending
# its own X-Forwarded-For cannot inject a value that wins.
# =============================================================================
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.0/8;
real_ip_header X-Forwarded-For;
real_ip_recursive off;

# =============================================================================
# Rate limiting
#
# A cheap first line that rejects floods before PHP is ever started. The
# application enforces its own, finer limits (see AppServiceProvider); these
# zones exist so an attacker cannot make Laravel boot at all.
#
# 10m of shared memory tracks roughly 160k distinct addresses.
# =============================================================================
limit_req_zone $binary_remote_addr zone=login:10m  rate=20r/m;
limit_req_zone $binary_remote_addr zone=api:10m    rate=120r/m;
limit_req_zone $binary_remote_addr zone=app:10m    rate=300r/m;
limit_req_status 429;
limit_req_log_level warn;

# =============================================================================
# HRIS Dashboard (Laravel / Inertia)
#
# Rendered at container start by the nginx image's envsubst entrypoint.
# HRIS_DASHBOARD_HOST and HRIS_PORTAL_HOST come from the environment, so the
# domains are deployment configuration rather than baked into the image.
# NGINX_ENVSUBST_FILTER restricts substitution to HRIS_* so nginx's own
# $variables are left untouched.
# =============================================================================
server {
    listen 80;
    server_name ${HRIS_DASHBOARD_HOST};

    root /var/www/html/public;
    index index.php;

    client_max_body_size 50M;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        # burst absorbs the handful of near-simultaneous requests an Inertia
        # page transition makes; nodelay serves them immediately rather than
        # queueing, and only excess beyond the burst is rejected.
        limit_req zone=app burst=60 nodelay;

        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        # Pass through what the upstream TLS-terminating proxy (host nginx)
        # already set, instead of $scheme (which is always "http" here).
        # Otherwise Laravel generates http:// asset URLs -> mixed content.
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_FOR   $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_HOST  $http_host;
        fastcgi_param HTTP_X_REAL_IP         $remote_addr;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}

# =============================================================================
# Employee SPA (static) + reverse-proxy /api → Laravel (FastCGI)
# =============================================================================
server {
    listen 80;
    server_name ${HRIS_PORTAL_HOST};

    root /var/www/employee;
    index index.html;

    client_max_body_size 50M;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    charset utf-8;

    # API requests are forwarded to Laravel's index.php via FastCGI.
    # Keeping /api on the same origin means session cookies work seamlessly.
    # Password guessing is the threat here, so this is deliberately strict.
    location = /api/login {
        limit_req zone=login burst=5 nodelay;

        fastcgi_pass app:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_FOR   $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_HOST  $http_host;
        fastcgi_param HTTP_X_REAL_IP         $remote_addr;
        fastcgi_hide_header X-Powered-By;
    }

    location /api {
        limit_req zone=api burst=30 nodelay;

        fastcgi_pass app:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_FOR   $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_HOST  $http_host;
        fastcgi_param HTTP_X_REAL_IP         $remote_addr;
        fastcgi_hide_header X-Powered-By;
    }

    # SPA fallback for client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}

# =============================================================================
# Attendance kiosk (static) + reverse-proxy /api/kiosk → Laravel (FastCGI)
#
# A separate vhost rather than a path on the portal, because this terminal is a
# screen strangers stand in front of. Only the kiosk endpoints are reachable
# from it — /api/login and the authenticated API are not proxied here at all, so
# a tampered browser on the terminal has nothing else to reach for.
#
# Bound to HRIS_KIOSK_HOST; deployments without a terminal leave that unset and
# the block matches nothing.
# =============================================================================
server {
    listen 80;
    server_name ${HRIS_KIOSK_HOST};

    root /var/www/kiosk;
    index index.html;

    # Scan photos are capped at 5 MB by the application's validation rules.
    client_max_body_size 10M;

    add_header X-Frame-Options "DENY";
    add_header X-Content-Type-Options "nosniff";

    charset utf-8;

    # Optional network lock. Uncomment and set the office's public address or
    # LAN range once it is known — this is the strongest location control the
    # terminal has, because unlike a URL it cannot be forwarded to somebody at
    # home. The per-device allowlist in the kiosk_devices table does the same
    # job and can be changed without a redeploy; use whichever fits.
    #
    # allow 203.0.113.0/24;
    # deny all;

    location /api/kiosk {
        limit_req zone=api burst=30 nodelay;

        fastcgi_pass app:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_FOR   $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_HOST  $http_host;
        fastcgi_param HTTP_X_REAL_IP         $remote_addr;
        fastcgi_hide_header X-Powered-By;
    }

    # Everything else under /api stays unreachable from the terminal's origin.
    location /api {
        return 404;
    }

    # SPA fallback for client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
